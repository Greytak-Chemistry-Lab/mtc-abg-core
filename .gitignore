# The .gitignore for this repo will have 3 parts 
# =======================================================================
# 1. MATLAB and Simulink Git Ignore Template (from Github via Google Gemini)
# =======================================================================

# Autosave and Backup Files
*.asv
*.m~
*.autosave
*.bak

# Simulink Backup & Autosave
*.slx.r*
*.mdl.r*
*.slx.original
*.mdl.original

# Compiled MEX binaries (All platforms)
*.mex*

# Packaged App and Toolbox Files
*.mlappinstall
*.mltbx

# Deployable Archives (MATLAB Compiler)
*.ctf

# Generated Documentation Search Folders
helpsearch*/

# Code Generation Folders (Simulink Coder / MATLAB Coder)
slprj/
sccprj/
codegen/

# Cache and Workspace Files
*.slxc
*.mexw64
*.mexa64
*.mexmaci64
octave-workspace

# Cloud Storage Tags
.MATLABDriveTag

# =======================================================================
# 2. Microsoft Office autosave and lock files (suggested by Google Gemini)
# =======================================================================

# Microsoft Word lock files
~$*.docx
~$*.doc

# Microsoft Excel lock files
~$*.xlsx
~$*.xls

# Microsoft PowerPoint lock files
~$*.pptx
~$*.ppt


# =======================================================================
# 3. Output data from example runs (specified manually: example scripts 
#    should be edited where necessary to respect this)
# =======================================================================

# Absolute path (should ignore this folder as specified from the root level)
/og/example_data/output

# Relative path (should ignore the entire folder and all contents, anywhere in the repo)
example_data/output

